{
  "manifest_version": 3,
  "name": "Voltra Companion Nightly",
  "version": "0.1.0.7",
  "version_name": "0.1.0-nightly.7",
  "description": "Send supported ModHub mods to your Voltra servers.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16": "icons/voltra-16.png", "32": "icons/voltra-32.png", "48": "icons/voltra-48.png", "128": "icons/voltra-128.png"},
  "action": {"default_title": "Open Voltra Companion", "default_icon": {"16": "icons/voltra-16.png", "32": "icons/voltra-32.png"}},
  "side_panel": {"default_path": "app.html"},
  "content_scripts": [{"matches": ["https://www.farming-simulator.com/mod.php*"], "js": ["content.js"]}]
}
