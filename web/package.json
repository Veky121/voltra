{
 "name": "voltra-web",
 "version": "0.1.0",
 "private": true,
 "type": "module",
 "scripts": {
  "dev": "vite --host 127.0.0.1 --port 5181 --strictPort",
  "build": "tsc --noEmit && vite build",
  "check": "tsc --noEmit && npm run lint && npm run format:check",
  "lint": "eslint src build vite.config.ts vite.file-manager-test.config.ts eslint.config.js",
  "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx,mjs,cjs}\" \"build/**/*.ts\" vite.config.ts vite.file-manager-test.config.ts eslint.config.js tsconfig.json components.json",
  "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx,mjs,cjs}\" \"build/**/*.ts\" vite.config.ts vite.file-manager-test.config.ts eslint.config.js tsconfig.json components.json",
  "test:editor": "node --experimental-strip-types --test tests/*.test.mjs"
 },
 "dependencies": {
  "@base-ui/react": "^1.9.0",
  "@codemirror/language": "^6.13.1",
  "@codemirror/language-data": "^6.5.2",
  "@codemirror/legacy-modes": "^6.5.5",
  "@codemirror/search": "^6.7.2",
  "@codemirror/state": "^6.7.6",
  "@codemirror/view": "^6.43.15",
  "@lezer/highlight": "^1.2.5",
  "@uppy/core": "^6.3.0",
  "@uppy/dashboard": "^6.0.2",
  "@uppy/react": "^6.1.0",
  "@uppy/tus": "^6.0.0",
  "class-variance-authority": "^0.7.1",
  "clsx": "^2.1.1",
  "codemirror": "^6.0.2",
  "lucide-react": "^1.61.0",
  "react": "^19.3.0",
  "react-dom": "^19.3.0",
  "react-router-dom": "^7.9.5",
  "tailwind-merge": "^3.7.0"
 },
 "devDependencies": {
  "@eslint/js": "^10.0.1",
  "@tailwindcss/vite": "^4.3.3",
  "@types/node": "^26.6.5",
  "@types/react": "^19.2.2",
  "@types/react-dom": "^19.2.2",
  "@vitejs/plugin-react": "^5.1.1",
  "eslint": "^10.15.0",
  "eslint-config-prettier": "^10.1.8",
  "eslint-plugin-react-hooks": "^7.1.1",
  "globals": "^17.14.0",
  "prettier": "^3.10.1",
  "tailwindcss": "^4.3.3",
  "typescript": "^5.9.3",
  "typescript-eslint": "^8.73.0",
  "vite": "^7.3.7"
 }
}
